# LibreNMS Port Bandwidth Alert - example configuration
# Copy to .env (for local runs) or /etc/librenms-port-bandwidth-alert.env (systemd example)

# --- Target device/port ---
DEVICE_HOSTNAME=example-device
# Set true to scan every port RRD under DEVICE_HOSTNAME.
MONITOR_ALL_PORTS=false
# Used in single-port mode (MONITOR_ALL_PORTS=false).
PORT_ID=12345

# --- Threshold logic ---
THRESHOLD_MBPS=50
# MODE: max (either direction), sum (in+out), in, out
MODE=max
# Check last N seconds (1 hour)
WINDOW_SECONDS=3600
# "Continuously" above threshold: 1.0 = all samples above threshold
MIN_FRACTION_ABOVE=1.0
# Minimum number of valid samples required
MIN_POINTS=4

# --- LibreNMS RRD location ---
RRD_BASE_DIR=/opt/librenms/rrd
# Optional: set exact RRD file path to skip auto-detection (single-port mode only)
# RRD_FILE=/opt/librenms/rrd/example-device/port-id12345.rrd

# --- Email ---
EMAIL_TO=someone@example.com
EMAIL_FROM=librenms-alert@example.com
EMAIL_SUBJECT_PREFIX="[Port Bandwidth Alert]"

# If SMTP_* not set, script will try to use local sendmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true

# Optional: resolve port names in alert emails from LibreNMS API
# Example:
# LIBRENMS_API_URL=https://nms.example.com/api/v0
# LIBRENMS_API_TOKEN=your_api_token
LIBRENMS_API_URL=
LIBRENMS_API_TOKEN=
# Optional: only alert for ports whose resolved name contains one of these substrings (case-insensitive)
# Example values (change for your environment):
# PORT_NAME_INCLUDE=@example1,@example2
PORT_NAME_INCLUDE=

# --- Operational ---
# Where to store last-alert state (optional). If empty, no cooldown state is stored.
STATE_FILE=/var/lib/librenms-port-bandwidth-alert/state.json
# Minimum seconds between emails (0 = every run). Recommended when running more frequently than hourly.
COOLDOWN_SECONDS=0

# Debug logging
DEBUG=false
